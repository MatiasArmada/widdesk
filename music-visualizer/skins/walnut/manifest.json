{
  "schema": 1,
  "id": "walnut",
  "name": "Walnut & Brass",
  "author": "Music Visualizer",
  "description": "A warm 70s hi-fi receiver: walnut veneer, brass knobs and a glowing dial.",
  "swatch": ["#5a3216", "#c9a24a", "#ffd27a"],
  "vars": {
    "--skin-accent": "#ff9a3c",
    "--skin-accent-2": "#ffd27a",

    "--skin-bg": "url(walnut.svg), #5a3216",
    "--skin-bg-image": "linear-gradient(180deg, rgba(255, 226, 180, 0.14), rgba(0, 0, 0, 0) 40%, rgba(0, 0, 0, 0.3))",
    "--skin-border": "1px solid #2a1608",
    "--skin-radius": "10px",
    "--skin-shadow": "inset 0 1px 0 rgba(255, 220, 170, 0.35), inset 0 -2px 0 rgba(0, 0, 0, 0.35), inset 0 0 0 3px rgba(40, 20, 8, 0.5)",

    "--skin-fg": "#f6e3c4",
    "--skin-fg-dim": "#e8c48e",
    "--skin-fg-faint": "#d8b483",
    "--skin-font": "'Palatino Linotype', 'Book Antiqua', Georgia, serif",
    "--skin-font-title": "'Palatino Linotype', 'Book Antiqua', Georgia, serif",
    "--skin-font-mono": "Georgia, 'Palatino Linotype', serif",
    "--skin-title-color": "#ffe2a8",
    "--skin-title-weight": "600",
    "--skin-title-spacing": "0.3px",
    "--skin-text-shadow": "0 0 6px rgba(255, 170, 60, 0.55)",

    "--skin-display-bg": "linear-gradient(180deg, #1a0f06, #2b1a0b)",
    "--skin-display-border": "1px solid #c9a24a",
    "--skin-display-radius": "4px",
    "--skin-display-shadow": "inset 0 0 14px rgba(255, 170, 60, 0.3), inset 0 1px 3px rgba(0, 0, 0, 0.8)",

    "--skin-button-fg": "#e8c48e",
    "--skin-button-radius": "50%",
    "--skin-button-hover-bg": "rgba(201, 162, 74, 0.28)",
    "--skin-button-hover-fg": "#fff3d6",
    "--skin-control-fg": "#2a1608",
    "--skin-control-radius": "50%",
    "--skin-close-hover-bg": "#8a2a12",
    "--skin-close-hover-fg": "#fff3d6",
    "--skin-pin-active": "#ffd27a",
    "--skin-chip-border": "1px solid #c9a24a",
    "--skin-focus": "#ffd27a",

    "--skin-play-bg": "radial-gradient(circle at 35% 30%, #fff1c1 0%, #e0b85a 30%, #a87a2a 70%, #6e4b15 100%)",
    "--skin-play-fg": "#2a1608",
    "--skin-play-hover-bg": "radial-gradient(circle at 35% 30%, #fff8dc 0%, #f0cc6a 35%, #b8862f 75%, #7a5418 100%)",
    "--skin-play-border": "1px solid #4a2f0e",
    "--skin-play-radius": "50%",
    "--skin-play-shadow": "0 2px 4px rgba(0, 0, 0, 0.6), inset 0 -2px 3px rgba(0, 0, 0, 0.35)",

    "--skin-art-bg": "repeating-radial-gradient(circle at 50% 50%, #161008 0px, #161008 2px, #22180c 2px, #22180c 3px)",
    "--skin-art-border": "2px solid #c9a24a",
    "--skin-art-radius": "50%",
    "--skin-art-shadow": "0 2px 6px rgba(0, 0, 0, 0.6)",
    "--skin-art-icon": "#e0b85a",

    "--skin-track-bg": "rgba(0, 0, 0, 0.45)",
    "--skin-track-fill": "linear-gradient(90deg, #a87a2a, #ffd27a)",
    "--skin-track-radius": "2px",
    "--skin-thumb-bg": "radial-gradient(circle at 35% 30%, #fff1c1, #c9a24a 60%, #6e4b15)",
    "--skin-thumb-shadow": "0 1px 2px rgba(0, 0, 0, 0.7)",

    "--skin-menu-bg": "#2b1a0b",
    "--skin-menu-fg": "#f6e3c4",
    "--skin-menu-border": "1px solid #c9a24a",
    "--skin-menu-radius": "6px",
    "--skin-menu-shadow": "0 8px 20px rgba(0, 0, 0, 0.6)",
    "--skin-menu-hover-bg": "rgba(201, 162, 74, 0.28)"
  },
  "visualizer": {
    "mode": "bars",
    "barCount": 24,
    "colors": ["#ff9a3c", "#ffd27a"],
    "gradient": "vertical",
    "peakColor": "#fff3d6",
    "glow": 6,
    "barGap": 0.5,
    "barRadius": 0.15,
    "opacity": 0.45,
    "reflection": false
  }
}
