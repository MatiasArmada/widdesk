{
  "schema": 1,
  "id": "phosphor",
  "name": "Phosphor 83",
  "author": "Music Visualizer",
  "description": "Amber monochrome CRT terminal with scanlines and an oscilloscope trace.",
  "swatch": ["#120b00", "#ffb000", "#ffd060"],
  "vars": {
    "--skin-accent": "#ffb000",
    "--skin-accent-2": "#ffd060",

    "--skin-bg": "radial-gradient(120% 100% at 50% 50%, #1e1200 0%, #120b00 60%, #050300 100%)",
    "--skin-border": "2px solid #2b1d06",
    "--skin-radius": "16px",
    "--skin-shadow": "inset 0 0 30px rgba(0, 0, 0, 0.85), inset 0 0 6px rgba(255, 176, 0, 0.25)",
    "--skin-overlay": "repeating-linear-gradient(180deg, rgba(0, 0, 0, 0.38) 0px, rgba(0, 0, 0, 0.38) 1px, rgba(0, 0, 0, 0) 1px, rgba(0, 0, 0, 0) 3px)",

    "--skin-fg": "#ffb000",
    "--skin-fg-dim": "#d18f00",
    "--skin-fg-faint": "#9a6a00",
    "--skin-font": "'Lucida Console', 'Courier New', monospace",
    "--skin-font-title": "'Lucida Console', 'Courier New', monospace",
    "--skin-font-mono": "'Lucida Console', 'Courier New', monospace",
    "--skin-title-color": "#ffc23d",
    "--skin-title-weight": "400",
    "--skin-title-transform": "uppercase",
    "--skin-title-spacing": "0.5px",
    "--skin-text-shadow": "0 0 5px rgba(255, 176, 0, 0.75)",

    "--skin-button-fg": "#ffb000",
    "--skin-button-border": "1px solid rgba(255, 176, 0, 0.45)",
    "--skin-button-radius": "0",
    "--skin-button-shadow": "0 0 6px rgba(255, 176, 0, 0.25)",
    "--skin-button-hover-bg": "#ffb000",
    "--skin-button-hover-fg": "#120b00",
    "--skin-control-fg": "#ffb000",
    "--skin-control-radius": "0",
    "--skin-close-hover-bg": "#ffb000",
    "--skin-close-hover-fg": "#120b00",
    "--skin-pin-active": "#ffe08a",
    "--skin-chip-border": "1px solid #ffb000",
    "--skin-focus": "#ffe08a",

    "--skin-play-bg": "#ffb000",
    "--skin-play-fg": "#120b00",
    "--skin-play-hover-bg": "#ffd060",
    "--skin-play-border": "1px solid #ffb000",
    "--skin-play-radius": "0",
    "--skin-play-shadow": "0 0 10px rgba(255, 176, 0, 0.6)",

    "--skin-art-bg": "repeating-linear-gradient(45deg, #1e1200 0px, #1e1200 4px, #2a1a02 4px, #2a1a02 8px)",
    "--skin-art-border": "1px solid #ffb000",
    "--skin-art-radius": "0",
    "--skin-art-shadow": "0 0 8px rgba(255, 176, 0, 0.35)",
    "--skin-art-icon": "#ffb000",

    "--skin-track-bg": "rgba(255, 176, 0, 0.15)",
    "--skin-track-fill": "#ffb000",
    "--skin-track-radius": "0",
    "--skin-thumb-bg": "#ffd060",
    "--skin-thumb-radius": "0",
    "--skin-thumb-shadow": "0 0 6px #ffb000",

    "--skin-menu-bg": "#120b00",
    "--skin-menu-fg": "#ffb000",
    "--skin-menu-border": "1px solid #ffb000",
    "--skin-menu-radius": "0",
    "--skin-menu-shadow": "0 0 12px rgba(255, 176, 0, 0.35)",
    "--skin-menu-hover-bg": "rgba(255, 176, 0, 0.2)"
  },
  "visualizer": {
    "mode": "wave",
    "colors": ["#ffb000"],
    "glow": 8,
    "lineWidth": 2,
    "opacity": 0.55,
    "barCount": 32,
    "barGap": 0.3,
    "barRadius": 0,
    "peakColor": "#ffd060",
    "reflection": false
  }
}
