{
  "schema": 1,
  "id": "chrome-amp",
  "name": "Chrome Amp",
  "author": "Music Visualizer",
  "description": "Late-90s desktop amp: brushed aluminium, chunky bevels and a green LCD.",
  "swatch": ["#b9bec5", "#0b1408", "#9cff3a"],
  "vars": {
    "--skin-accent": "#9cff3a",
    "--skin-accent-2": "#ffd23a",

    "--skin-bg": "linear-gradient(180deg, rgba(255, 255, 255, 0.35) 0%, rgba(255, 255, 255, 0) 18%, rgba(0, 0, 0, 0) 70%, rgba(0, 0, 0, 0.22) 100%), linear-gradient(90deg, #8d939b, #c9ced4 22%, #a4aab2 48%, #d5d9de 74%, #959ba3)",
    "--skin-bg-image": "url(brushed.svg)",
    "--skin-border": "1px solid #2e3136",
    "--skin-radius": "6px",
    "--skin-shadow": "inset 1px 1px 0 #f4f6f8, inset -1px -1px 0 #5b6068, inset 2px 2px 0 rgba(255, 255, 255, 0.35), inset -2px -2px 0 rgba(0, 0, 0, 0.2)",

    "--skin-fg": "#15181b",
    "--skin-fg-dim": "#7fd63a",
    "--skin-fg-faint": "#1f2a17",
    "--skin-font": "Tahoma, Verdana, 'Segoe UI', sans-serif",
    "--skin-font-title": "'Lucida Console', 'Courier New', monospace",
    "--skin-font-mono": "'Lucida Console', 'Courier New', monospace",
    "--skin-title-color": "#9cff3a",
    "--skin-title-weight": "400",
    "--skin-title-transform": "uppercase",
    "--skin-title-spacing": "1px",
    "--skin-text-shadow": "0 0 4px rgba(140, 255, 60, 0.45)",

    "--skin-titlebar-bg": "linear-gradient(180deg, #6b717a, #3c4047)",
    "--skin-titlebar-border": "1px solid #1d2024",
    "--skin-display-bg": "linear-gradient(180deg, #0b1408, #142410)",
    "--skin-display-border": "1px solid #1a1d20",
    "--skin-display-radius": "2px",
    "--skin-display-shadow": "inset 1px 1px 0 #000, inset 0 0 12px rgba(120, 255, 60, 0.12), 1px 1px 0 rgba(255, 255, 255, 0.7)",

    "--skin-button-fg": "#1d2024",
    "--skin-button-bg": "#b9bec5",
    "--skin-button-image": "linear-gradient(180deg, rgba(255, 255, 255, 0.85), rgba(255, 255, 255, 0) 55%, rgba(0, 0, 0, 0.15))",
    "--skin-button-border": "1px solid #2e3136",
    "--skin-button-radius": "2px",
    "--skin-button-shadow": "inset 1px 1px 0 #ffffff, inset -1px -1px 0 #6b7078",
    "--skin-button-hover-bg": "#e2e6ea",
    "--skin-button-hover-fg": "#000000",
    "--skin-control-fg": "#1d2024",
    "--skin-control-radius": "3px",
    "--skin-close-hover-bg": "#d83a2e",
    "--skin-close-hover-fg": "#ffffff",
    "--skin-pin-active": "#2f8a00",
    "--skin-chip-border": "1px solid #2e3136",
    "--skin-focus": "#2f8a00",

    "--skin-play-bg": "linear-gradient(180deg, #f6f8fa, #b7bcc3 60%, #9aa0a8)",
    "--skin-play-fg": "#1d2024",
    "--skin-play-hover-bg": "linear-gradient(180deg, #ffffff, #cfd3d8)",
    "--skin-play-border": "1px solid #2e3136",
    "--skin-play-radius": "4px",
    "--skin-play-shadow": "inset 1px 1px 0 #ffffff, inset -1px -1px 0 #6b7078, 0 1px 0 rgba(255, 255, 255, 0.6)",

    "--skin-art-bg": "linear-gradient(135deg, #1b2a14, #0b1408)",
    "--skin-art-border": "1px solid #2e3136",
    "--skin-art-radius": "2px",
    "--skin-art-shadow": "inset 1px 1px 0 #000, 1px 1px 0 rgba(255, 255, 255, 0.7)",
    "--skin-art-icon": "#7fd63a",

    "--skin-track-bg": "#1b2a14",
    "--skin-track-fill": "linear-gradient(90deg, #4fbf1a, #9cff3a)",
    "--skin-track-radius": "1px",
    "--skin-thumb-bg": "linear-gradient(180deg, #ffffff, #a9aeb5)",
    "--skin-thumb-radius": "1px",
    "--skin-thumb-shadow": "0 0 0 1px #2e3136",

    "--skin-menu-bg": "#c3c8ce",
    "--skin-menu-fg": "#111111",
    "--skin-menu-border": "1px solid #2e3136",
    "--skin-menu-radius": "3px",
    "--skin-menu-shadow": "inset 1px 1px 0 #ffffff, inset -1px -1px 0 #6b7078, 0 6px 16px rgba(0, 0, 0, 0.35)",
    "--skin-menu-hover-bg": "rgba(0, 0, 0, 0.12)"
  },
  "visualizer": {
    "mode": "bars",
    "barCount": 32,
    "colors": ["#3ad12a", "#d6f02a", "#ff3a1a"],
    "gradient": "vertical",
    "peakColor": "#f2f4f6",
    "barGap": 0.28,
    "barRadius": 0,
    "opacity": 0.6,
    "reflection": false
  }
}
